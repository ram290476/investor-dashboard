project            = "invdash"
region             = "us-west-1"
dr_region          = "us-west-2" # must differ from region
alert_emails       = ["you@example.com"] # also receive the us-east-1 CloudFront alarm topic
monthly_budget_usd = 40

# Fill in once the dashboard is deployed behind CloudFront:
# health_url                 = "https://dXXXXXXXXXXXX.cloudfront.net/health.json"
# cloudfront_distribution_id = "EXXXXXXXXXXXXX" # only to watch a different distribution
# enable_cloudfront_alarms   = true             # CloudFront 5xx alarm in us-east-1

# Stricter audit lock (cannot be removed by anyone, including root, until it expires):
# audit_object_lock_mode = "COMPLIANCE"

# Site and jobs (after the first deploy of the site and the job image):
# site_origins       = ["https://dXXXXXXXXXXXX.cloudfront.net"]
# site_callback_urls = ["https://dXXXXXXXXXXXX.cloudfront.net/auth/callback"]
# site_logout_urls   = ["https://dXXXXXXXXXXXX.cloudfront.net/"]
# jobs_image_uri     = "<account>.dkr.ecr.us-west-1.amazonaws.com/invdash/jobs:<git-sha>"
# sec_user_agent     = "investor-dashboard you@example.com"

# Custom domain. Leave unset until the GoDaddy steps in docs/operations.md are done.
# Empty keeps today's CloudFront certificate, Cognito URLs and CORS. No Route 53 records.
# site_domain = "investor.vellamsetti.com"
# Issue #103. Must stay false; the cloudfront.net to custom-domain redirect is not implemented.
# redirect_cloudfront_to_custom_domain = false
